# Required: bearer token the MCP client must present.
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: enables live shelf-stock checks. Everything else works without it.
SYSTEMBOLAGET_API_KEY=

# Which interface to publish the MCP port on. Default 127.0.0.1 keeps it
# host-local; set this to the VPN address to reach it from other machines.
BIND_ADDR=127.0.0.1
HOST_PORT=8848

# Weekly, Friday 19:00 Europe/Stockholm. Releases are weekly and pre-announced,
# so nightly buys nothing and triples load on an undocumented API.
CRON_SCHEDULE=0 19 * * 5
SYNC_STORES=1001 1002
