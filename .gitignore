# Built binary (root only -- an unanchored "bolagetdb" would also match cmd/bolagetdb/)
/bolagetdb

# Local database and its WAL sidecars
/bolaget.db
/bolaget.db-wal
/bolaget.db-shm

# Dated JSONL snapshots. Large, and regenerated by `bolagetdb sync`.
/snapshots/
/sync.log
/store-sync.log

# Built skill package. Regenerate with `make skill`.
/dist/

# Local compose configuration (holds the auth token).
.env

# MCP client config: holds the bearer token. Commit .mcp.json.example instead.
.mcp.json
