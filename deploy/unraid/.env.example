# Copy to .env beside compose.yaml on the Unraid server, then fill in.
# This file holds a credential — do not commit the filled-in version.

# Required. The bearer token Claude sends on every request.
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Required. The Unraid LAN address, e.g. 192.168.1.10 — NOT 0.0.0.0.
# Until the tunnel is in place, this is the only thing that can reach the port.
BIND_ADDR=

# Optional. Enables live shelf-stock checks; everything else works without it.
SYSTEMBOLAGET_API_KEY=

# Where the mirror lives. Must be owned by uid 10001 (see the runbook).
APPDATA=/mnt/user/appdata/sommelier

HOST_PORT=8848
TZ=Europe/Stockholm

# Weekly, Friday 19:00. Switch to "0 8 * * 4" if web allocations matter more —
# every allocation drop lands on a Thursday.
CRON_SCHEDULE=0 19 * * 5

# Stores whose assortment is mirrored. ~1 minute each per sync.
SYNC_STORES=1001 1002

# Pin a release instead of tracking latest, once you have one.
IMAGE_TAG=latest
